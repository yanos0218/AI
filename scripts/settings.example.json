{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "//": "~/.claude/settings.json 예시 — CLI·VS Code 확장·Mac·Linux·Windows 공통. model 등 기기별 값은 기존 파일 것을 유지하고 아래 키만 합친다.",

  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git tag --list*)",
      "Bash(gh pr view*)",
      "Bash(gh run list*)",
      "Bash(gh release view*)",
      "Bash(ls*)",
      "Bash(node --check*)",
      "Bash(python -m pytest*)",
      "Bash(npm test*)",
      "Bash(./gradlew compileJava*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Edit(./.env)",
      "Edit(./.env.*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/git-guardrails.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },

  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/hooks/statusline.sh"
  }
}
