{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "//": "pre-commit-check는 if 조건 없이 모든 Bash에 걸고, 스크립트가 commit·.sh 글자가 없으면 바로 끝낸다. if Bash(git *)는 echo x && git commit 같은 복합 명령을 못 잡아 경고·차단이 우회됐다(Issue #192, 같은 훅이 여러 개 동시에 뜨던 문제는 Issue #147·#148)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/baseline-guard.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-check.sh\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-check.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/handoff-stale-check.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-end-check.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
