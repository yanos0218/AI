{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "//": "if 조건은 명령 이름만 쓴다(Bash(git *) 등). \"git commit *\"처럼 인자까지 쓰면 $()·heredoc 명령에서 조건과 상관없이 전부 발동해 같은 훅이 여러 개 동시에 떴다(Issue #147·#148)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/baseline-guard.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-check.sh\"",
            "timeout": 120
          },
          {
            "type": "command",
            "if": "Bash(bash *)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-check.sh\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-check.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-end-check.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
