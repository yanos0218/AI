{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "//": "~/.claude/settings.json 예시 — CLI·VS Code 확장·Mac·Linux·Windows 공통. model 등 기기별 값은 기존 파일 것을 유지하고 아래 키만 합친다.",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git tag --list*)",
      "Bash(gh pr view*)",
      "Bash(gh run list*)",
      "Bash(gh release view*)",
      "Bash(ls*)",
      "Bash(node --check*)",
      "Bash(python -m pytest*)",
      "Bash(npm test*)",
      "Bash(./gradlew compileJava*)",
      "Bash(python -m py_compile*)",
      "Bash(npx markdownlint-cli2*)",
      "Bash(npx shellcheck*)",
      "Bash(bash -n*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(grep *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Edit(./.env)",
      "Edit(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/git-guardrails.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "bash ~/.claude/hooks/gh-throttle.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(bash *)",
            "command": "bash ~/.claude/hooks/gh-throttle.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "bash ~/.claude/hooks/format-guard.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "bash ~/.claude/hooks/format-guard.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/gh-throttle.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/format-guard.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/*.md)",
            "command": "bash ~/.claude/hooks/md-format-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Write(**/*.md)",
            "command": "bash ~/.claude/hooks/md-format-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "MultiEdit(**/*.md)",
            "command": "bash ~/.claude/hooks/md-format-check.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(~/.claude/**)",
            "command": "bash ~/.claude/hooks/config-changelog.sh",
            "async": true,
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Write(~/.claude/**)",
            "command": "bash ~/.claude/hooks/config-changelog.sh",
            "async": true,
            "timeout": 30
          },
          {
            "type": "command",
            "if": "MultiEdit(~/.claude/**)",
            "command": "bash ~/.claude/hooks/config-changelog.sh",
            "async": true,
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/config-changelog.sh",
            "async": true,
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/bulk-read-log.sh",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-start-check.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/compact-snapshot-show.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/compact-snapshot.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/skills/usage-dashboard/scripts/usage.sh hook",
            "async": true,
            "timeout": 60
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/hooks/statusline.sh"
  }
}
